/target
**/target

# Vector generator dependencies. package.json and package-lock.json are
# committed (they pin the upstream rxdb version the oracle runs against);
# the installed tree is not.
node_modules/
.dagr/

# graft's local graph cache and per-harness scaffolding. The cache is
# regenerable (`graft build`); the scaffolding files are generated per checkout
# by `graft init` and would otherwise land in every lane's commits.
/graft/
/AGENTS.md
/GEMINI.md
/.ignore
/.mcp.json
/opencode.json
/.claude/
/.gemini/
/.grok/
/.github/copilot-instructions.md

# Python bytecode from the testkit generators (`gen/*.py`).
__pycache__/
*.pyc
